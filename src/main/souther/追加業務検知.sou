// =====================================================================
//  追加業務検知 — Souther 版
//
//  学生アシスタント（アルバイト）の労働時間帯を講義時間帯と突き合わせ、
//  「講義時間内の通常労働」と「講義時間外の追加労働」に分割する。
//
//  元の Java 実装との対応は docs/souther-migration.md を参照。
//  各定義の上の【Souther:…】コメントは、そこで使っている Souther の機能を示す。
// =====================================================================
module com.example.Backend.souther.追加業務検知 exposing (
    科目名,
    学籍番号,
    学生の名前,
    業務内容,
    曜日,
    月,
    火,
    水,
    木,
    金,
    土,
    日,
    時間帯,
    講義情報,
    時間割に科目がない,
    アルバイト実施報告,
    曜日付きアルバイト実施報告,
    労働時間帯の区分,
    講義のない曜日の労働,
    講義時間外の労働,
    講義時間内の労働,
    講義前にはみ出した労働,
    講義後にはみ出した労働,
    講義の前後にはみ出した労働,
    追加業務検知の結果,
    追加業務検知の結果一覧,
    時間割から講義情報を取得する,
    アルバイト実施報告書を取得する,
    曜日を付ける,
    労働時間帯を分割する,
    一件を検知する,
    追加業務を検知する
)

// ---------------------------------------------------------------------
//  値（Java: record/*.java の String ラッパー群）
// ---------------------------------------------------------------------
// 【Souther: newtype + 名前付き invariant】
// Java では record 科目名(String) で空文字も null も通っていた。
// Souther では「空でない」が型の一部になり、Decoder・構築のたびに検査される。
data 科目名 = String
    invariant 空でない = String.length(value) > 0

data 学籍番号 = String
    invariant 空でない = String.length(value) > 0

data 学生の名前 = String
    invariant 空でない = String.length(value) > 0

data 業務内容 = String

// 【Souther: sum（unit case の列挙）】
// Java では 講義の曜日(String) / アルバイトの曜日(String) が別々の文字列で、
// 一致判定は String.equals に頼っていた（"月" と "月曜" の表記ゆれは検出できない）。
// Souther では曜日は 7 つの case のどれかでしかありえない。
data 曜日 = 月 | 火 | 水 | 木 | 金 | 土 | 日

// 【Souther: product + invariant】
// Java の record 時間帯(LocalTime, LocalTime) は 開始 >= 終了 を許していた。
// その結果、長さ 0 の労働（例 9:00〜9:00）が「講義時間内」と「講義時間外」の
// 両方の判定に当てはまり、通常労働と追加労働の両方が同時にセットされることがあった。
// ここでは「開始は終了より前」を型が保証するので、その状態はそもそも作れない。
data 時間帯 =
    { 開始: Time
    , 終了: Time
    }
    invariant 開始は終了より前 = 開始 < 終了

data 講義情報 =
    { 講義の曜日: 曜日
    , 講義時間帯: 時間帯
    }

// 【Souther: unit data を「業務上の結果」として返す】
// Java の 時間割.取得する は科目が無いと JdbcClient の .single() が例外を投げていた。
// ここでは「時間割に科目がない」は例外ではなく、出力の case の一つ。
data 時間割に科目がない =
    { 科目: 科目名
    }

// Java: 曜日なしアルバイト情報
data アルバイト実施報告 =
    { 学籍番号: 学籍番号
    , 学生の名前: 学生の名前
    , 日にち: Date
    , 労働時間帯: 時間帯
    , 業務内容: 業務内容
    }

// 【Souther: field spread（...）】
// Java: 曜日付きアルバイト情報 は 曜日なしアルバイト情報 の全フィールドを
// 手で書き写していた。Souther では「報告 + 曜日」と書く。
data 曜日付きアルバイト実施報告 =
    { ...アルバイト実施報告
    , 曜日: 曜日
    }

// ---------------------------------------------------------------------
//  判定結果（Java: 通常労働時間帯と追加労働時間帯 — 4 つの null 許容フィールド）
// ---------------------------------------------------------------------
// 【Souther: sum で「ありうる結果」を閉じる】
// Java では 4 つのフィールド（通常 / 前の追加 / 後ろの追加 / 全て追加）が
// それぞれ null かどうかの組み合わせで結果を表していた（2^4 = 16 通り）。
// 実際に意味があるのは 6 通りだけで、それ以外の組み合わせ（例: 通常も全て追加も null）は
// 型の上では作れてしまい、表示側は NullPointerException を catch して凌いでいた。
// Souther では 6 通りを case として列挙し、各 case は必要なフィールドだけを持つ。
data 労働時間帯の区分 = 講義のない曜日の労働
    | 講義時間外の労働
    | 講義時間内の労働
    | 講義前にはみ出した労働
    | 講義後にはみ出した労働
    | 講義の前後にはみ出した労働

// Java 4.1: 曜日が一致しない → 全て追加労働
data 講義のない曜日の労働 =
    { 追加労働時間帯: 時間帯
    }

// Java 4.4: 講義時間と重ならない → 全て追加労働
data 講義時間外の労働 =
    { 追加労働時間帯: 時間帯
    }

// Java 4.2: 講義時間に全て含まれる → 全て通常労働
data 講義時間内の労働 =
    { 通常労働時間帯: 時間帯
    }

// 【Souther: 複数フィールドにまたがる invariant】
// 分割した時間帯は隙間なく続いていなければならない、という業務上の約束を型に書く。
// Java 4.3.2
data 講義前にはみ出した労働 =
    { 前の追加労働時間帯: 時間帯
    , 通常労働時間帯: 時間帯
    }
    invariant 隙間なく続く = 前の追加労働時間帯.終了 == 通常労働時間帯.開始

// Java 4.3.3
data 講義後にはみ出した労働 =
    { 通常労働時間帯: 時間帯
    , 後の追加労働時間帯: 時間帯
    }
    invariant 隙間なく続く = 通常労働時間帯.終了 == 後の追加労働時間帯.開始

// Java 4.3.1
data 講義の前後にはみ出した労働 =
    { 前の追加労働時間帯: 時間帯
    , 通常労働時間帯: 時間帯
    , 後の追加労働時間帯: 時間帯
    }
    invariant 前と隙間なく続く = 前の追加労働時間帯.終了 == 通常労働時間帯.開始
    invariant 後と隙間なく続く = 通常労働時間帯.終了 == 後の追加労働時間帯.開始

// Java: 追加業務検知の結果
data 追加業務検知の結果 =
    { ...曜日付きアルバイト実施報告
    , 区分: 労働時間帯の区分
    }

// 【Souther: コレクションの newtype】
// 出力の case にはリストを直接置けない（match の arm で名前を書けないため）。
// Java の 追加業務検知の結果リスト と同じく、名前を付けた型にする。
data 追加業務検知の結果一覧 = List<追加業務検知の結果>

// ---------------------------------------------------------------------
//  外界への依存（Java: 時間割インターフェース / アルバイト実施報告書インターフェース）
// ---------------------------------------------------------------------
// 【Souther: 実装を書かない behavior = Java から注入される依存】
// DB アクセスは Souther の外。Java 側が生成された基底クラスを継承して実装する。
behavior 時間割から講義情報を取得する : (科目: 科目名) -> 講義情報 | 時間割に科目がない
    constructs 講義情報, 時間割に科目がない

behavior アルバイト実施報告書を取得する : (科目: 科目名) -> List<アルバイト実施報告>
    constructs アルバイト実施報告

// ---------------------------------------------------------------------
//  カレンダー（Java: カレンダー.java — Locale.JAPAN の表示名で曜日文字列を作っていた）
// ---------------------------------------------------------------------
// 2024-01-01 は月曜日。そこからの日数を 7 で割った余りで曜日が決まる。
let 基準の月曜日 = Date("2024-01-01")

// 【Souther: unreachable — モデルが起こり得ないと言い切る箇所に理由を書く】
let 曜日を求める (d: Date): 曜日 =
    match List.get(
        Int.floorMod(Date.daysBetween(基準の月曜日, d), 7),
        [月, 火, 水, 木, 金, 土, 日]
    ) with
        | Some w -> w
        | None -> unreachable "7 で割った余りは 0〜6 なので、7 要素のリストから必ず取れる"

behavior 曜日を付ける : (報告: アルバイト実施報告) -> 曜日付きアルバイト実施報告
    constructs 曜日付きアルバイト実施報告

let 曜日を付ける (報告) = 曜日付きアルバイト実施報告 { ...報告, 曜日 = 曜日を求める(報告.日にち) }

// ---------------------------------------------------------------------
//  労働時間帯分割（Java: 労働時間帯分割.java + specification/*.java の 7 ルール）
// ---------------------------------------------------------------------
// 【Souther: behavior の出力は bare sum / guard / constructs / ensures】
// Java は 7 つの specification クラス（BiPredicate の組み合わせ）を if で入れ子にし、
// 結果を null の代入で組み立てていた。ルール同士が排他であることは誰も保証していなかった。
// Souther では guard と if の分岐がそのまま 6 つの case に対応し、
// どの分岐でどの case を返すかは match の網羅性・constructs と example で検査される。
behavior 労働時間帯を分割する : (
    講義: 講義情報,
    労働時間帯: 時間帯,
    労働の曜日: 曜日
) -> 講義のない曜日の労働
    | 講義時間外の労働
    | 講義時間内の労働
    | 講義前にはみ出した労働
    | 講義後にはみ出した労働
    | 講義の前後にはみ出した労働
    constructs 時間帯,
        講義のない曜日の労働,
        講義時間外の労働,
        講義時間内の労働,
        講義前にはみ出した労働,
        講義後にはみ出した労働,
        講義の前後にはみ出した労働
    // 【Souther: ensures — 入力と出力の関係を宣言し、example がそれに縛られる】
    ensures 労働全体を保つ = 講義のない曜日の労働 | 講義時間外の労働 -> value.追加労働時間帯
        == 労働時間帯 | 講義時間内の労働 -> value.通常労働時間帯
        == 労働時間帯 | 講義前にはみ出した労働 -> value.前の追加労働時間帯.開始 == 労働時間帯.開始
        && value.通常労働時間帯.終了
            == 労働時間帯.終了 | 講義後にはみ出した労働 -> value.通常労働時間帯.開始
        == 労働時間帯.開始
        && value.後の追加労働時間帯.終了
            == 労働時間帯.終了 | 講義の前後にはみ出した労働 -> value.前の追加労働時間帯.開始
        == 労働時間帯.開始
        && value.後の追加労働時間帯.終了 == 労働時間帯.終了

let 労働時間帯を分割する (講義, 労働, 労働の曜日) = {
    let 講義時間 = 講義.講義時間帯

    // Java 4.1 曜日が一致するかルール
    guard 労働の曜日 == 講義.講義の曜日 else 講義のない曜日の労働 { 追加労働時間帯 = 労働 }

    // Java 4.4 講義時間以外で労働しているルール（の否定 = 重なりがある）
    guard 労働.終了 > 講義時間.開始 && 労働.開始 < 講義時間.終了
        else 講義時間外の労働 { 追加労働時間帯 = 労働 }

    if 労働.開始 < 講義時間.開始 then
        if 労働.終了 > 講義時間.終了 then
            // Java 4.3.1 講義前から講義後まで労働しているルール
            講義の前後にはみ出した労働 {
                前の追加労働時間帯 = 時間帯 { 開始 = 労働.開始, 終了 = 講義時間.開始 },
                通常労働時間帯 = 講義時間,
                後の追加労働時間帯 = 時間帯 { 開始 = 講義時間.終了, 終了 = 労働.終了 }
            }
        else
            // Java 4.3.2 講義開始前に労働を開始し講義終了までに労働を終了しているルール
            講義前にはみ出した労働 {
                前の追加労働時間帯 = 時間帯 { 開始 = 労働.開始, 終了 = 講義時間.開始 },
                通常労働時間帯 = 時間帯 { 開始 = 講義時間.開始, 終了 = 労働.終了 }
            }
    else
        if 労働.終了 > 講義時間.終了 then
            // Java 4.3.3 講義開始後に労働を開始し講義終了後に労働を終了しているルール
            講義後にはみ出した労働 {
                通常労働時間帯 = 時間帯 { 開始 = 労働.開始, 終了 = 講義時間.終了 },
                後の追加労働時間帯 = 時間帯 { 開始 = 講義時間.終了, 終了 = 労働.終了 }
            }
        else
            // Java 4.2 労働時間帯が講義時間帯に全て含まれるルール
            講義時間内の労働 { 通常労働時間帯 = 労働 }
}

// ---------------------------------------------------------------------
//  ユースケース（Java: usecase/追加業務検知.java）
// ---------------------------------------------------------------------
behavior 一件を検知する : (講義: 講義情報, 報告: アルバイト実施報告) -> 追加業務検知の結果
    constructs 追加業務検知の結果

let 一件を検知する (講義, 報告) = {
    let 曜日付き = 曜日を付ける(報告)
    追加業務検知の結果 {
        ...曜日付き,
        区分 = 労働時間帯を分割する(講義, 曜日付き.労働時間帯, 曜日付き.曜日)
    }
}

// 【Souther: depends on — 外界への依存は宣言が必須。example では fake で差し替える】
behavior 追加業務を検知する : (科目: 科目名) -> 追加業務検知の結果一覧 | 時間割に科目がない
    depends on 時間割から講義情報を取得する, アルバイト実施報告書を取得する

let 追加業務を検知する (科目, 時間割から講義情報を取得する, アルバイト実施報告書を取得する) =
    match 時間割から講義情報を取得する(科目) with
        | 時間割に科目がない as なし -> なし
        | 講義情報 as 講義
            -> 追加業務検知の結果一覧(
                List.map(報告 -> 一件を検知する(講義, 報告), アルバイト実施報告書を取得する(科目))
            )
