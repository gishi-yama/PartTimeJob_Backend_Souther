// =====================================================================
//  追加業務検知 の example（コンパイル時に評価される仕様の具体例）
//
//  【Souther: examples for — 例をモデル本体と別ファイルに置く】
//  Java 版にはこの処理のテストが 1 本もなかった（BackendApplicationTests は contextLoads のみ）。
//  Souther の example は「テスト」ではなく仕様の一部で、成り立たない行があるとコンパイルが通らない。
//  `souther examples` は、どの場合分け・境界にまだ行が無いかを報告する。
// =====================================================================
examples for com.example.Backend.souther.追加業務検知

// 講義: 水曜 10:40〜12:10
let 水曜2限 =
    講義情報 { 講義の曜日 = 水, 講義時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") } }

// ---------------------------------------------------------------------
//  曜日を付ける（Java: カレンダー）
// ---------------------------------------------------------------------
let 報告の雛形 =
    アルバイト実施報告 {
        学籍番号 = 学籍番号("b2240001"),
        学生の名前 = 学生の名前("千歳 太郎"),
        日にち = Date("2026-11-25"),
        労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
        業務内容 = 業務内容("演習補助")
    }

example 曜日を付ける
    | "2026-11-25 は水曜日"
        : (報告の雛形)
        -> 曜日付きアルバイト実施報告 { ...報告の雛形, 曜日 = 水 }
    | "基準日 2024-01-01 は月曜日"
        : (アルバイト実施報告 { ...報告の雛形, 日にち = Date("2024-01-01") })
        -> 曜日付きアルバイト実施報告 { ...報告の雛形, 日にち = Date("2024-01-01"), 曜日 = 月 }
    | "基準日より前の日付（2023-12-31 は日曜日）"
        : (アルバイト実施報告 { ...報告の雛形, 日にち = Date("2023-12-31") })
        -> 曜日付きアルバイト実施報告 { ...報告の雛形, 日にち = Date("2023-12-31"), 曜日 = 日 }
    // 【souther examples の指摘で追加】invariant の境界（ON point）に立つ値
    //   学籍番号・学生の名前は 1 文字、時間帯は 1 秒（開始 = 終了 - 1 秒）
    | "1 文字の学籍番号・氏名、1 秒だけの労働（invariant の境界）"
        : (
            アルバイト実施報告 {
                ...報告の雛形,
                学籍番号 = 学籍番号("1"),
                学生の名前 = 学生の名前("千"),
                労働時間帯 = 時間帯 { 開始 = Time("10:40:00"), 終了 = Time("10:40:01") }
            }
        )
        -> 曜日付きアルバイト実施報告 {
            ...報告の雛形,
            学籍番号 = 学籍番号("1"),
            学生の名前 = 学生の名前("千"),
            労働時間帯 = 時間帯 { 開始 = Time("10:40:00"), 終了 = Time("10:40:01") },
            曜日 = 水
        }

// ---------------------------------------------------------------------
//  労働時間帯を分割する（Java: 労働時間帯分割 4.1〜4.4）
// ---------------------------------------------------------------------
example 労働時間帯を分割する
    // Java 4.1
    | "講義の無い曜日に働いた → 全て追加労働"
        : (水曜2限, 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }, 木)
        -> 講義のない曜日の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    // Java 4.4
    | "講義の前に終わった → 全て追加労働"
        : (水曜2限, 時間帯 { 開始 = Time("09:00"), 終了 = Time("10:00") }, 水)
        -> 講義時間外の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("09:00"), 終了 = Time("10:00") }
        }
    | "講義の開始ちょうどに終わった → 重なりなし（境界）"
        : (水曜2限, 時間帯 { 開始 = Time("09:00"), 終了 = Time("10:40") }, 水)
        -> 講義時間外の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("09:00"), 終了 = Time("10:40") }
        }
    | "講義の終了ちょうどから働いた → 重なりなし（境界）"
        : (水曜2限, 時間帯 { 開始 = Time("12:10"), 終了 = Time("13:00") }, 水)
        -> 講義時間外の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("12:10"), 終了 = Time("13:00") }
        }
    // Java 4.2
    | "講義時間ぴったり → 全て通常労働"
        : (水曜2限, 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }, 水)
        -> 講義時間内の労働 {
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    | "講義時間の途中だけ → 全て通常労働"
        : (水曜2限, 時間帯 { 開始 = Time("11:00"), 終了 = Time("11:30") }, 水)
        -> 講義時間内の労働 {
            通常労働時間帯 = 時間帯 { 開始 = Time("11:00"), 終了 = Time("11:30") }
        }
    // Java 4.3.2
    | "講義の前から講義の途中まで → 前が追加労働"
        : (水曜2限, 時間帯 { 開始 = Time("10:00"), 終了 = Time("11:00") }, 水)
        -> 講義前にはみ出した労働 {
            前の追加労働時間帯 = 時間帯 { 開始 = Time("10:00"), 終了 = Time("10:40") },
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("11:00") }
        }
    | "講義の前から講義終了ちょうどまで（境界）"
        : (水曜2限, 時間帯 { 開始 = Time("10:00"), 終了 = Time("12:10") }, 水)
        -> 講義前にはみ出した労働 {
            前の追加労働時間帯 = 時間帯 { 開始 = Time("10:00"), 終了 = Time("10:40") },
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    // Java 4.3.3
    | "講義の途中から講義の後まで → 後ろが追加労働"
        : (水曜2限, 時間帯 { 開始 = Time("11:30"), 終了 = Time("13:00") }, 水)
        -> 講義後にはみ出した労働 {
            通常労働時間帯 = 時間帯 { 開始 = Time("11:30"), 終了 = Time("12:10") },
            後の追加労働時間帯 = 時間帯 { 開始 = Time("12:10"), 終了 = Time("13:00") }
        }
    | "講義開始ちょうどから講義の後まで（境界）"
        : (水曜2限, 時間帯 { 開始 = Time("10:40"), 終了 = Time("13:00") }, 水)
        -> 講義後にはみ出した労働 {
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            後の追加労働時間帯 = 時間帯 { 開始 = Time("12:10"), 終了 = Time("13:00") }
        }
    // Java 4.3.1
    | "講義の前から講義の後まで → 前後が追加労働"
        : (水曜2限, 時間帯 { 開始 = Time("10:00"), 終了 = Time("13:00") }, 水)
        -> 講義の前後にはみ出した労働 {
            前の追加労働時間帯 = 時間帯 { 開始 = Time("10:00"), 終了 = Time("10:40") },
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            後の追加労働時間帯 = 時間帯 { 開始 = Time("12:10"), 終了 = Time("13:00") }
        }

// 【souther examples の指摘で追加】
// 1. 曜日: 講義の曜日・労働の曜日のどちらにも 7 つの case すべてが現れるようにする。
//    曜日の一致判定（==）は sum の順序上の「線」として読まれ、
//    隣の曜日（OFF point）と離れた曜日（OUT point）の両方に行を要求される。
// 2. 時刻の境界: Time は秒まで持つので、「ちょうど」の 1 秒内側（ON point）にも行を置く。
//    Java 版では isBefore / isAfter / equals の組み合わせの取り違えがここで起きやすい。
example 労働時間帯を分割する
    | "月曜の講義・月曜の労働"
        : (
            講義情報 { ...水曜2限, 講義の曜日 = 月 },
            時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            月
        )
        -> 講義時間内の労働 {
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    | "火曜の講義・前日（月曜）の労働"
        : (
            講義情報 { ...水曜2限, 講義の曜日 = 火 },
            時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            月
        )
        -> 講義のない曜日の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    | "木曜の講義・2 日前（火曜）の労働"
        : (
            講義情報 { ...水曜2限, 講義の曜日 = 木 },
            時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            火
        )
        -> 講義のない曜日の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    | "金曜の講義・2 日後（日曜）の労働"
        : (
            講義情報 { ...水曜2限, 講義の曜日 = 金 },
            時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            日
        )
        -> 講義のない曜日の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    | "土曜の講義・土曜の労働"
        : (
            講義情報 { ...水曜2限, 講義の曜日 = 土 },
            時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            土
        )
        -> 講義時間内の労働 {
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    | "日曜の講義・前々日（金曜）の労働"
        : (
            講義情報 { ...水曜2限, 講義の曜日 = 日 },
            時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            金
        )
        -> 講義のない曜日の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    | "講義開始の 1 秒後に終わった → 1 秒だけ通常労働"
        : (水曜2限, 時間帯 { 開始 = Time("10:00"), 終了 = Time("10:40:01") }, 水)
        -> 講義前にはみ出した労働 {
            前の追加労働時間帯 = 時間帯 { 開始 = Time("10:00"), 終了 = Time("10:40") },
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("10:40:01") }
        }
    | "講義開始の 1 秒前に始めた → 1 秒だけ前が追加労働"
        : (水曜2限, 時間帯 { 開始 = Time("10:39:59"), 終了 = Time("11:00") }, 水)
        -> 講義前にはみ出した労働 {
            前の追加労働時間帯 = 時間帯 { 開始 = Time("10:39:59"), 終了 = Time("10:40") },
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("11:00") }
        }
    | "講義終了の 1 秒前に始めた → 1 秒だけ通常労働"
        : (水曜2限, 時間帯 { 開始 = Time("12:09:59"), 終了 = Time("13:00") }, 水)
        -> 講義後にはみ出した労働 {
            通常労働時間帯 = 時間帯 { 開始 = Time("12:09:59"), 終了 = Time("12:10") },
            後の追加労働時間帯 = 時間帯 { 開始 = Time("12:10"), 終了 = Time("13:00") }
        }
    | "講義終了の 1 秒後まで働いた → 1 秒だけ後ろが追加労働"
        : (水曜2限, 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10:01") }, 水)
        -> 講義後にはみ出した労働 {
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            後の追加労働時間帯 = 時間帯 { 開始 = Time("12:10"), 終了 = Time("12:10:01") }
        }
    | "講義前から講義終了の 1 秒後まで → 前後が追加労働"
        : (水曜2限, 時間帯 { 開始 = Time("10:00"), 終了 = Time("12:10:01") }, 水)
        -> 講義の前後にはみ出した労働 {
            前の追加労働時間帯 = 時間帯 { 開始 = Time("10:00"), 終了 = Time("10:40") },
            通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") },
            後の追加労働時間帯 = 時間帯 { 開始 = Time("12:10"), 終了 = Time("12:10:01") }
        }
    | "講義が終わってしばらく後に働いた → 全て追加労働"
        : (水曜2限, 時間帯 { 開始 = Time("13:00"), 終了 = Time("14:30") }, 水)
        -> 講義時間外の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("13:00"), 終了 = Time("14:30") }
        }

// ---------------------------------------------------------------------
//  一件を検知する
// ---------------------------------------------------------------------
let 講義のない曜日の結果 =
    追加業務検知の結果 {
        ...報告の雛形,
        曜日 = 水,
        区分 = 講義のない曜日の労働 {
            追加労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
        }
    }

example 一件を検知する
    | "水曜の講義時間ぴったりの報告"
        : (水曜2限, 報告の雛形)
        -> 追加業務検知の結果 {
            ...報告の雛形,
            曜日 = 水,
            区分 = 講義時間内の労働 {
                通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
            }
        }
    // 【souther examples の指摘で追加】講義の曜日 7 通り。水曜の報告なので水曜以外は全て追加労働。
    | "月曜の講義に対する水曜の報告"
        : (講義情報 { ...水曜2限, 講義の曜日 = 月 }, 報告の雛形)
        -> 講義のない曜日の結果
    | "火曜の講義に対する水曜の報告"
        : (講義情報 { ...水曜2限, 講義の曜日 = 火 }, 報告の雛形)
        -> 講義のない曜日の結果
    | "木曜の講義に対する水曜の報告"
        : (講義情報 { ...水曜2限, 講義の曜日 = 木 }, 報告の雛形)
        -> 講義のない曜日の結果
    | "金曜の講義に対する水曜の報告"
        : (講義情報 { ...水曜2限, 講義の曜日 = 金 }, 報告の雛形)
        -> 講義のない曜日の結果
    | "土曜の講義に対する水曜の報告"
        : (講義情報 { ...水曜2限, 講義の曜日 = 土 }, 報告の雛形)
        -> 講義のない曜日の結果
    | "日曜の講義に対する水曜の報告"
        : (講義情報 { ...水曜2限, 講義の曜日 = 日 }, 報告の雛形)
        -> 講義のない曜日の結果

// ---------------------------------------------------------------------
//  追加業務を検知する（Java: usecase/追加業務検知）
//  【Souther: fake — 注入される依存（DB）を example の中だけで差し替える】
// ---------------------------------------------------------------------
fake 時間割から講義情報を取得する
    | (科目名("プログラミング演習")) -> 水曜2限
    | (科目名("演"))                 -> 時間割に科目がない { 科目 = 科目名("演") }
    | _                              -> 時間割に科目がない { 科目 = 科目名("存在しない科目") }

fake アルバイト実施報告書を取得する
    | (科目名("プログラミング演習"))
        -> [報告の雛形, アルバイト実施報告 { ...報告の雛形, 日にち = Date("2026-11-26") }]
    | _ -> []

// 【Souther: 注入される behavior への example — 実行はされず「記録」される】
// Java 実装（DB アクセス）が満たすべき入出力を書いておく。fake の表と食い違うとコンパイルエラーになる。
example 時間割から講義情報を取得する
    | "時間割にある科目は講義情報を返す" : (科目名("プログラミング演習")) -> 水曜2限
    | "時間割に無い科目は、その科目名を添えて「時間割に科目がない」を返す"
        : (科目名("演"))
        -> 時間割に科目がない { 科目 = 科目名("演") }

example 追加業務を検知する
    | "時間割にある科目は報告ごとに分割する"
        : (科目名("プログラミング演習"))
        -> 追加業務検知の結果一覧(
            [
                追加業務検知の結果 {
                    ...報告の雛形,
                    曜日 = 水,
                    区分 = 講義時間内の労働 {
                        通常労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
                    }
                },
                追加業務検知の結果 {
                    ...報告の雛形,
                    日にち = Date("2026-11-26"),
                    曜日 = 木,
                    区分 = 講義のない曜日の労働 {
                        追加労働時間帯 = 時間帯 { 開始 = Time("10:40"), 終了 = Time("12:10") }
                    }
                }
            ]
        )
    | "時間割に無い科目は「時間割に科目がない」を返す（Java では例外だった）"
        : (科目名("存在しない科目"))
        -> 時間割に科目がない { 科目 = 科目名("存在しない科目") }
    // 【souther examples の指摘で追加】科目名の invariant の境界（1 文字）
    | "1 文字の科目名" : (科目名("演")) -> 時間割に科目がない { 科目 = 科目名("演") }
